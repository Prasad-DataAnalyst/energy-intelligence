# ─────────────────────────────────────────────────────────────────────────────
# DriftWire326 — Pipeline Finance Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI (Required) ─────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Voice Synthesis (Optional — falls back to pyttsx3 if not set) ─────────────
# Get from: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM    # Rachel voice (default)

# ── Market Data (Optional — yfinance works without these) ─────────────────────
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# FRED (St. Louis Fed economic data): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── YouTube API ───────────────────────────────────────────────────────────────
# Download OAuth2 client secrets from Google Cloud Console
# APIs & Services > Credentials > OAuth 2.0 Client IDs > Download JSON
# Rename to config/finance_oauth.json
YOUTUBE_CLIENT_SECRETS=config/finance_oauth.json

# ── Email Alerts (Optional) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL=your-alert-email@gmail.com

# ── Reliability ───────────────────────────────────────────────────────────────
# Let the 18:00 ET dead-man switch auto-publish the emergency fallback video
# when no upload was recorded today. Off by default — enable once you trust it.
# FALLBACK_AUTO_UPLOAD=true

# ── Optional Overrides ────────────────────────────────────────────────────────
# CLAUDE_MODEL=claude-sonnet-4-6
# DAILY_UPLOAD_QUOTA=4
# TIMEZONE=America/New_York
# SMTP_PORT=587

# ── Low-memory hosts (GCP free-tier e2-micro: 1 GB RAM) ──────────────────────
# Render at 720p to keep moviepy inside RAM+swap. Shorts stay vertical.
# VIDEO_RESOLUTION=1280x720
# SHORTS_RESOLUTION=720x1280
# VIDEO_FPS=30
