# ── Viral Pipeline API Keys ────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# All keys are optional — the pipeline falls back gracefully when missing.

# Required for script generation, storyboard, and metadata (Phase 2 & 7)
ANTHROPIC_API_KEY=sk-ant-...

# Premium AI voice synthesis (Phase 3) — falls back to espeak-ng if missing
ELEVENLABS_API_KEY=...

# AI image generation via Replicate (Phase 4) — falls back to PIL mock if missing
REPLICATE_API_TOKEN=r8_...

# Stock footage / images (Phase 4) — falls back to generated visuals if missing
PEXELS_API_KEY=...
PIXABAY_API_KEY=...

# Royalty-free music search (Phase 3) — falls back to procedural music if missing
PIXABAY_API_KEY=...

# YouTube upload (optional — uses existing youtube_automation credentials)
YOUTUBE_CHANNEL_ID=
