# ══════════════════════════════════════════════════════════════════════════
#  GetMindFuelNow — .env template
#  Copy to .env on the VM and fill in the values. .env is gitignored — it
#  never travels with git pull, so keep the VM copy up to date by hand.
#  After editing, ALWAYS verify with:  python3 doctor.py
# ══════════════════════════════════════════════════════════════════════════

# ── REQUIRED: Claude content generation ──────────────────────────────────────
# Get from console.anthropic.com → API Keys. Starts with sk-ant-
# Without this the pipeline aborts at preflight every morning.
ANTHROPIC_API_KEY=

# ── REQUIRED: YouTube OAuth ──────────────────────────────────────────────────
# Google account: prasad2t@gmail.com
# Download client_secrets.json from Google Cloud Console and keep it here.
# Then run:  python3 reauth_youtube.py   (creates youtube_token.json)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Your YouTube channel ID
# HOW TO FIND IT: youtube.com → click your avatar → Settings → Advanced settings
# It looks like: UCxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# Category 24 = Entertainment (where horoscope content lives).
# Other options: 22=People & Blogs, 27=Education
YOUTUBE_CATEGORY_ID=24

# public | private | unlisted
YOUTUBE_PRIVACY_STATUS=public

# ── STRONGLY RECOMMENDED: failure alerts ─────────────────────────────────────
# Gmail App Password (NOT your account password):
# myaccount.google.com → Security → 2-Step Verification → App passwords
# Without this, the doctor/summary/heartbeat alert emails are silent no-ops.
GMAIL_APP_PASSWORD=
GMAIL_ADDRESS=prasad2t@gmail.com

# Optional but recommended: external dead-man's switch that catches total VM
# death. Create a free daily check at https://healthchecks.io and paste its
# ping URL. The pipeline pings it after each successful run; if pings stop,
# healthchecks.io emails you — even when the VM itself is down.
HEALTHCHECK_URL=

# ── Publishing ───────────────────────────────────────────────────────────────
# Hour (UTC) the daily video goes public. 10 = 6 AM ET (US morning).
# If YouTube Analytics shows a large India/Europe audience, try 4 or 5
# (morning IST — the video is then already live when the US wakes up).
PUBLISH_HOUR_UTC=10

# Optional: playlist to auto-add each daily video to (50 quota units/day).
# Create the playlist once in YouTube Studio, copy its ID from the URL
# (youtube.com/playlist?list=PLxxxx → the PLxxxx part).
YOUTUBE_PLAYLIST_ID=

# ── Rendering ────────────────────────────────────────────────────────────────
# Crossfade motion between cards. CPU-heavy: keep false on an e2-micro;
# enable on a 2+ vCPU VM for smoother transitions.
MOTION_ENABLED=false

# ── Legacy (per-sign pipeline only — the daily all-signs video ignores these)─
OUTPUT_DIR=output
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=24
VIDEO_DURATION_SECONDS=160
UPLOAD_TIME=15:00
EIA_API_KEY=
