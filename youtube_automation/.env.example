# YouTube OAuth credentials (from Google Cloud Console)
# Download client_secrets.json from Google Cloud Console and set path here
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# YouTube channel settings
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID_HERE
YOUTUBE_CATEGORY_ID=28          # Science & Technology (25=News, 22=People&Blogs)
YOUTUBE_PRIVACY_STATUS=public   # public | private | unlisted

# EIA API key for live energy data (https://www.eia.gov/opendata/)
EIA_API_KEY=YOUR_EIA_API_KEY_HERE

# Video output settings
OUTPUT_DIR=output
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=24
VIDEO_DURATION_SECONDS=180      # 3-minute daily briefing

# Scheduling (24-hour format, server local time)
UPLOAD_TIME=08:00

# Notification email (optional)
NOTIFY_EMAIL=prasad2t@gmail.com
