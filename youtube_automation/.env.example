# ── YouTube OAuth ────────────────────────────────────────────────────────────
# Download client_secrets.json from Google Cloud Console and keep it here.
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Your YouTube channel ID  (youtube.com/channel/UC... → copy the UC... part)
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# Category 27 = Education (highest US CPM, $15-40)
# Other options: 26=How-to & Style, 22=People & Blogs, 28=Science & Tech
YOUTUBE_CATEGORY_ID=27

# public | private | unlisted
YOUTUBE_PRIVACY_STATUS=public

# ── Video settings ───────────────────────────────────────────────────────────
OUTPUT_DIR=output
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=24
VIDEO_DURATION_SECONDS=160

# ── Upload schedule ──────────────────────────────────────────────────────────
# 3 PM local time → peak US EST browsing window (best CTR for initial velocity)
UPLOAD_TIME=15:00

# ── EIA key (optional — no longer used in general-audience mode) ─────────────
EIA_API_KEY=
